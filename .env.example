# Application
APP_NAME=PolicyPilot AI
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL
POSTGRES_DB=policypilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/policypilot
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/policypilot

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=hr_policy_chunks

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Security & JWT
JWT_SECRET_KEY=super-secret-dev-jwt-key-minimum-32-characters-for-hs256
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM & Embedding Providers (gemini | openai | anthropic | ollama | mock)
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSION=1536

# Provider Keys (optional if using mock or ollama)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
