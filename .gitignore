.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
nosetests.xml
coverage/

# Node.js & Next.js
node_modules/
**/node_modules/
.next/
**/.next/
out/
build/
.pnp
.pnp.js
*.tsbuildinfo
